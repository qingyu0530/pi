#!/bin/sh

# Git 钩子在仓库根目录执行；原版 pi 项目位于 pi/ 子目录，检查在该目录下运行。
PI_DIR="pi"

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

node "$PI_DIR/scripts/check-lockfile-commit.mjs"
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
(cd "$PI_DIR" && npm run check)
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=0
for file in $STAGED_FILES; do
  case "$file" in
    pi/packages/ai/*|pi/packages/web-ui/*|pi/package.json|pi/package-lock.json)
      RUN_BROWSER_SMOKE=1
      break
      ;;
  esac
done

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  (cd "$PI_DIR" && npm run check:browser-smoke)
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"